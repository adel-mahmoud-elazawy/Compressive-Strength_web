# Backend environment configuration
PORT=8000
HOST=127.0.0.1

# Comma-separated list of allowed browser origins.
# Default: localhost/127.0.0.1 on port 3000.
# Do NOT add "*" in production: it disables credentialed CORS requests
# and allows any site to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: override the model bundle location.
# MODEL_PATH=/absolute/path/to/concrete_model.pkl
